# @name    Matchday
# @desc    Today's scores from every league you follow, as a ticker or pages. Hides itself on days with no games.
# @author  Jeremy Warren
# @version 1.0
# @display 52x16
# @config  leagues  text   "Leagues"        default="soccer/uefa.champions,soccer/uefa.europa,soccer/uefa.europa.conf,soccer/eng.1,soccer/esp.1,soccer/ger.1,soccer/ita.1,soccer/fra.1" maxlen=256 help="ESPN paths, comma separated. Also soccer/usa.1, football/nfl"
# @config  mode     select "Display"        default=ticker options=ticker,pages
# @config  every    number "Live refresh"   default=45 min=20 max=300 unit=s help="How often each live game is re-read"
# @config  upcoming bool   "Show upcoming"  default=true
# @config  finals   bool   "Show finished"  default=true
# @config  speed    slider "Ticker speed"   default=120 min=50 max=300 unit=% group=Layout
# @config  pageSec  number "Seconds a page" default=4 min=2 max=30 unit=s group=Layout

# ESPN's scoreboard for a league is far too large to parse here (100 KB+ on a
# matchday), so each game is read on its own (about 13 KB) from a small list of
# ids. json.load is used rather than field-order regexes because ESPN has
# reordered these fields before.

import json
import string

class Matchday
  var leagues, ev, date, every, busy, gap, failAt, dirty, due
  var ticker, opts, pieces, pending, rows, page, pageAt, pageMs
  var live, done, stale

  def init()
    self.ev = []
    self.date = 0
    self.every = int(store.get("every"))
    self.busy = false
    self.gap = 0
    self.failAt = 0
    self.dirty = false
    self.due = 0
    self.ticker = store.get("mode") != "pages"
    self.opts = {"repeat": 1, "mode": "wrap", "entry": "offscreen", "whenFits": "scroll", "speed": int(store.get("speed"))}
    self.pieces = []
    self.pending = nil
    self.rows = []
    self.page = 0
    self.pageAt = 0
    self.pageMs = int(store.get("pageSec")) * 1000
    self.live = 0
    self.done = 0
    self.stale = false
    var names = {
      "uefa.champions": ["UCL", 0x4D8DFF], "uefa.europa": ["UEL", 0xFF8A00], "uefa.europa.conf": ["UECL", 0x2ECC71],
      "eng.1": ["EPL", 0xC77DFF], "esp.1": ["LIGA", 0xFF5A5A], "ger.1": ["BUN", 0xFF3030], "ita.1": ["SERA", 0x3CA0FF],
      "fra.1": ["LIG1", 0xB8E000], "usa.1": ["MLS", 0x60C0FF], "nfl": ["NFL", 0x5AA0FF], "college-football": ["CFB", 0xFFB000]
    }
    # The pattern doubles as the check on what reaches a URL.
    self.leagues = []
    for s : re.matchall("[a-z]+/[a-z0-9._-]+", store.get("leagues"))
      if size(self.leagues) >= 12 break end
      var c = string.find(s, "/")
      var sport = s[0 .. c - 1]
      var lg = s[c + 1 .. size(s) - 1]
      var n = names.find(lg)
      if n == nil
        var dot = string.find(lg, ".")
        n = [string.toupper(dot > 0 ? lg[0 .. dot - 1] : lg), 0xC0C0C0]
      end
      # sport, league, tag, colour, next list read, away team first
      self.leagues.push([sport, lg, n[0], n[1], 0, sport != "soccer"])
    end
  end

  def on_list(l, b, st)
    self.busy = false
    var t = epoch_ms() / 1000
    self.gap = t + 2
    if b == nil || st != 200
      l[4] = t + 300
      if self.failAt == 0 self.failAt = t end
      return
    end
    self.failAt = 0
    for m : re.matchall("events/\\d+", b)
      if size(self.ev) >= 60 break end
      var id = m[7 .. size(m) - 1]
      var seen = false
      for e : self.ev
        if e[0] == id seen = true break end
      end
      # id, league, first, second, score 1, score 2, state, status, kickoff, read at, postponed
      if !seen self.ev.push([id, l, "", "", "", "", "", "", 0, 0, false]) end
    end
  end

  def on_game(e, b, st)
    self.busy = false
    var t = epoch_ms() / 1000
    self.gap = t + 2
    if b == nil || st != 200
      if self.failAt == 0 self.failAt = t end
      return
    end
    try
      var d = json.load(b)
      var ty = d.find("status").find("type")
      var cs = d.find("competitions")[0].find("competitors")
      var h = cs[0]
      var a = cs[1]
      if h.find("homeAway") != "home"
        h = cs[1]
        a = cs[0]
      end
      var first = e[1][5] ? a : h
      var second = e[1][5] ? h : a
      var state = ty.find("state")
      var name = ty.find("name", "")
      var label = ty.find("shortDetail", "")
      var off = string.find(name, "POSTPONED") >= 0 || string.find(name, "CANCELED") >= 0
      if off label = string.find(name, "POSTPONED") >= 0 ? "PPD" : "CAN" end
      if e[8] == 0
        var s = d.find("date")
        var y = int(s[0 .. 3])
        var mo = int(s[5 .. 6])
        if mo <= 2 y -= 1 end
        var era = y / 400
        var yoe = y - era * 400
        var doy = (153 * (mo + (mo > 2 ? -3 : 9)) + 2) / 5 + int(s[8 .. 9]) - 1
        e[8] = (era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468) * 86400 + int(s[11 .. 12]) * 3600 + int(s[14 .. 15]) * 60
      end
      if state == "pre" && !off
        # The clock only gives local time, so its zone comes from comparing the two.
        var o = hour() * 60 + minute() - (t / 60) % 1440
        if o > 840 o -= 1440 elif o < -720 o += 1440 end
        var m = ((e[8] / 60 + o) % 1440 + 1440) % 1440
        var hh = m / 60
        var mm = m % 60
        if settings.get("time24h") == false
          label = str(hh % 12 == 0 ? 12 : hh % 12) + string.format(":%02d", mm) + (hh < 12 ? "a" : "p")
        else
          label = string.format("%d:%02d", hh, mm)
        end
      end
      var fa = first.find("team").find("abbreviation")
      var sa = second.find("team").find("abbreviation")
      var fs = first.find("score", "0")
      var ss = second.find("score", "0")
      if e[6] != state || e[7] != label || e[4] != fs || e[5] != ss self.dirty = true end
      e[2] = fa
      e[3] = sa
      e[4] = fs
      e[5] = ss
      e[6] = state
      e[7] = label
      e[10] = off
      self.failAt = 0
    except .. as err, msg
      log("Matchday: " + str(msg))
    end
  end

  def rebuild(t)
    self.dirty = false
    self.due = t + 15
    var live = []
    var soon = []
    var done = []
    for e : self.ev
      if e[6] == "in"
        live.push(e)
      elif e[6] == "pre"
        if store.get("upcoming")
          var i = 0
          while i < size(soon) && soon[i][8] <= e[8] i += 1 end
          soon.insert(i, e)
        end
      elif e[6] == "post" && store.get("finals")
        done.push(e)
      end
    end
    self.live = size(live)
    self.done = size(done)
    var rows = []
    for g : [live, soon, done]
      for e : g
        var kind = e[6]
        var mid = (kind == "pre" || e[10]) ? "v" : e[4] + "-" + e[5]
        var col = kind == "in" ? 0x00E676 : (kind == "pre" ? 0xFFFFFF : 0xB0B0B0)
        var sc = kind == "in" ? 0x00E676 : (kind == "pre" ? 0xFFC107 : 0x808080)
        rows.push([e[1][2], e[1][3], e[7], sc, e[2] + " " + mid + " " + e[3], col])
      end
    end
    self.rows = rows
    if self.page >= size(rows) self.page = 0 end
    if self.ticker
      var p = []
      for r : rows
        p.push([r[0] + " ", r[1]])
        p.push([r[4] + " ", r[5]])
        p.push([r[2] + "    ", r[3]])
      end
      # Text that changes width restarts the scroll, and a live clock changes
      # every minute, so new text waits until the app is next shown.
      if size(self.pieces) == 0 self.pieces = p else self.pending = p end
    end
  end

  def loop()
    var t = epoch_ms()
    if t < 0 return end
    t /= 1000
    var d = year() * 10000 + month() * 100 + day()
    if d != self.date
      self.date = d
      var keep = []
      for e : self.ev
        if e[6] == "in" keep.push(e) end
      end
      self.ev = keep
      for l : self.leagues l[4] = 0 end
      self.dirty = true
    end
    # Counted from a failed read, not the last good one: once every game is
    # finished the app rightly reads nothing for up to an hour.
    self.stale = self.failAt > 0 && t - self.failAt > 300
    if self.dirty && t >= self.due self.rebuild(t) end
    if self.busy || t < self.gap return end
    for l : self.leagues
      if l[4] <= t
        l[4] = t + 3600
        self.busy = true
        http.get("https://sports.core.api.espn.com/v2/sports/" + l[0] + "/leagues/" + l[1] + "/events?limit=50&dates=" + str(self.date),
                 / b, st -> self.on_list(l, b, st))
        return
      end
    end
    var pick = nil
    var best = t
    for e : self.ev
      var s = e[6]
      var at = nil
      if s == ""
        at = e[9] + (e[9] > 0 ? 60 : 0)
      elif s == "in"
        at = e[9] + self.every
      elif s == "pre"
        at = e[9] + (t >= e[8] - 120 ? self.every : 900)
      end
      if at != nil && at <= best
        best = at
        pick = e
      end
    end
    if pick != nil
      var e = pick
      e[9] = t
      self.busy = true
      http.get("https://site.api.espn.com/apis/site/v2/sports/" + e[1][0] + "/" + e[1][1] + "/scoreboard/" + e[0],
               / b, st -> self.on_game(e, b, st), {'cap': 48000})
    end
  end

  def should_show()
    return size(self.rows) > 0
  end

  def duration()
    return self.ticker ? 0 : min(size(self.rows) * self.pageMs, 120000)
  end

  def on_show()
    if self.pending != nil
      self.pieces = self.pending
      self.pending = nil
    end
    self.pageAt = now_ms()
  end

  def on_knob(ev)
    var n = size(self.rows)
    if self.ticker || n == 0 || (ev != "left" && ev != "right") return false end
    self.page = (self.page + (ev == "right" ? 1 : n - 1)) % n
    self.pageAt = now_ms()
    return true
  end

  def draw()
    clear()
    var n = size(self.rows)
    if n == 0
      text(1, 6, "MATCHDAY", 0x808080)
      return
    end
    if self.ticker
      if self.stale
        text(0, 6, "NO SIGNAL", 0xFF5252)
      else
        if self.live > 0
          text(0, 6, str(self.live) + " LIVE", 0x00E676)
        else
          text(0, 6, "TODAY", 0xFFC107)
        end
        if self.done > 0
          var f = str(self.done) + " FT"
          text(width() - text_ink_width(f), 6, f, 0x808080)
        end
      end
      font("large")
      var r = scroll_text(0, 14, width(), self.pieces, 0xFFFFFF, self.opts)
      # With other apps in the rotation, on_show() applies new text. A second
      # finished pass means nothing else took over, so apply it here instead.
      if r >= 2 && self.pending != nil
        self.pieces = self.pending
        self.pending = nil
      end
      return
    end
    if now_ms() - self.pageAt >= self.pageMs
      self.page = (self.page + 1) % n
      self.pageAt = now_ms()
    end
    var p = self.rows[self.page]
    text(0, 6, p[0], p[1])
    text(width() - text_ink_width(p[2]), 6, p[2], self.stale ? 0xFF5252 : p[3])
    font("large")
    if text_ink_width(p[4]) > width() font("small") end
    text((width() - text_ink_width(p[4])) / 2, 14, p[4], p[5])
  end
end

return Matchday()
